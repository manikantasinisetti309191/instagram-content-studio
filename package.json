{
  "name": "ai-instagram-automation",
  "version": "1.0.0",
  "description": "Fully autonomous AI-powered Instagram news automation system",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test:integration": "node backend/scripts/integrationTest.js",
    "test:deploy": "node backend/scripts/postDeployCheck.js",
    "test:deploy:wait": "node backend/scripts/postDeployCheck.js --wait",
    "test:all": "npm run test:integration && npm run test:deploy",
    "test:research": "node backend/agents/researchAgent.js --test",
    "test:content": "node backend/agents/contentAgent.js --test",
    "test:carousel": "node backend/services/carouselRenderer.js --test",
    "run-pipeline": "node backend/agents/pipelineRunner.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@napi-rs/canvas": "^1.0.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "form-data": "^4.0.1",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
