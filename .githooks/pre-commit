#!/bin/sh
# Pre-commit hook — runs integration test before every git commit
# Ensures content schema ↔ renderer are always in sync

echo ""
echo "🧪 Running integration test before commit..."
echo "   (Tests all 5 content patterns end-to-end)"
echo ""

node backend/scripts/integrationTest.js

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ COMMIT BLOCKED — Integration test failed"
  echo "   Fix the issues then try committing again."
  echo "   Debug: node backend/scripts/integrationTest.js"
  echo ""
  exit 1
fi

echo ""
echo "✅ Integration test passed — committing..."
echo ""
